# Godot-specific ignores
.godot/
*.tmp
# export_presets.cfg is TRACKED (checked clean of credentials 2026-07-23):
# no keystore entries, no encryption keys. If Android signing is ever
# configured in the editor, move the credentials to environment overrides
# (EDITOR: Export > Options > "Environment variables") — never commit them.

# Editor tool snapshots (Ziva)
/.ziva/

# Node (validate-data, balance sim tooling)
node_modules/

# Legacy Angular reference — local tool/config noise
legacy-angular/node_modules/
legacy-angular/.claude/
legacy-angular/.deploy_marker
# legacy-angular/public/ — kept for Godot portrait paths; see legacy-angular/README.md

# OS cruft
.DS_Store
Thumbs.db

# Build artifacts
build/
dist/

# LAN test-server self-signed cert (generated by tools/serve_web.py)
tools/serve_web_cert.pem
tools/serve_web_key.pem

# Raw art/audio source packs (icons extracted into assets/icons/items + assets/ui)
/assets/icons/new icons/
/audio files/

# Debug captures / transient logs
/debug_artifacts/
# baselines/ is TRACKED on purpose: the canonical per-screen capture set,
# regenerated once per visual build as its own commit so diffs are reviewable.
# debug_artifacts/ stays ignored scratch.
debug_screenshot.png
*.log
debug_readout_*.txt
tmp_*.py
__pycache__

# Balance-sim run outputs (regenerated; not source)
results/

# Godot GDExtension hot-reload artifacts (editor copies the dll to ~name at
# launch and deletes it on clean exit; never source, locked while editor runs)
~*.dll
~*.dll~*.TMP
