[gd_resource type="Theme" load_steps=7 format=3 uid="uid://b8ov1theme0ovl"]

; Overload Protocol default Theme — MIRRORS the canonical PixelUI DT_* palette
; (scripts/ui/pixel_ui.gd). This only provides default font + per-Control-type
; default styles so NEW Control nodes inherit the Dithered-Terminal baseline
; without per-node code. The battle screen's signature look (dither overlays,
; per-side card tints, dynamic dividers, bevels) stays programmatic in PixelUI.
; Do NOT hand-edit colors here independently — keep them equal to PixelUI.

[ext_resource type="FontFile" uid="uid://cp7ja8pelvxgs" path="res://assets/fonts/m5x7.ttf" id="1_font"]

